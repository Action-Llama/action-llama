#!/bin/sh

AL_EXPORT_FILE_PATH="${AL_EXPORT_FILE:-${AL_ENV_FILE:-/tmp/env.sh}}"

ensure_export_file() {
  mkdir -p "$(dirname "$AL_EXPORT_FILE_PATH")"
  : >> "$AL_EXPORT_FILE_PATH"
}

if [ "$1" = "-f" ]; then
  ensure_export_file
  printf '%s\n' "$AL_EXPORT_FILE_PATH"
  exit 0
fi

if [ $# -lt 2 ]; then
  echo 'usage: al-export NAME value [NAME2 value2 ...] | al-export -f' >&2
  exit 1
fi

count=0
ensure_export_file

while [ $# -ge 1 ]; do
  if [ $# -lt 2 ]; then
    echo 'usage: al-export NAME value [NAME2 value2 ...] | al-export -f' >&2
    exit 1
  fi

  case "$1" in
    [!a-zA-Z_]* | *[!a-zA-Z0-9_]*)
      echo "al-export: invalid variable name: $1" >&2
      exit 1
      ;;
  esac

  name="$1"
  value="$2"
  shift 2

  escaped=$(printf '%s' "$value" | sed "s/'/'\\\\''/g")
  printf "export %s='%s'\n" "$name" "$escaped" >> "$AL_EXPORT_FILE_PATH"
  count=$((count + 1))
done

if [ "$count" -eq 1 ]; then
  echo "exported 1 variable"
else
  echo "exported $count variables"
fi
